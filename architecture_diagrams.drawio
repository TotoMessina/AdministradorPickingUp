                <mxCell id="rt-c4" value="DB Event Trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#0ea5e9;strokeWidth=2;" parent="1" source="hub-db" target="hub-ch1" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
