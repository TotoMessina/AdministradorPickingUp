    <diagram id="realtime-pos-sync" name="3. Realtime &amp; POS Offline Sync">
        <mxGraphModel dx="1464" dy="922" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" background="#0f172a" math="0" shadow="1">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="rt-title" value="📡 Flujo de Sincronización Realtime Multi-Sucursal y Resiliencia POS Offline" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#f8fafc;" parent="1" vertex="1">
                    <mxGeometry x="400" y="20" width="1000" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="box-suc-a" value="SUCURSAL A — TERMINAL POS (Caja 01)" style="swimlane;whiteSpace=wrap;html=1;fillColor=rgba(16, 185, 129, 0.08);strokeColor=#10b981;fontColor=#34d399;fontStyle=1;fontSize=13;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="100" width="480" height="450" as="geometry"/>
                </mxCell>
                <mxCell id="a-sale" value="1. Registra Venta en POS Terminal&lt;br&gt;&lt;i&gt;POSTerminalModal.tsx&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#065f46;strokeColor=#10b981;fontColor=#ffffff;fontStyle=1;fontSize=11;" parent="box-suc-a" vertex="1">
                    <mxGeometry x="30" y="50" width="420" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="a-idb" value="2. Encola en IndexedDB Local&lt;br&gt;&lt;i&gt;OfflinePOSStore.ts (sales_queue)&lt;/i&gt;&lt;br&gt;&lt;span style=&quot;color:#fcd34d;&quot;&gt;Garantiza funcionamiento sin internet&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#78350f;strokeColor=#f59e0b;fontColor=#ffffff;fontSize=11;" parent="box-suc-a" vertex="1">
                    <mxGeometry x="30" y="150" width="420" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="a-net" value="3. Detecta Conexión de Red (window.onLine)&lt;br&gt;&lt;i&gt;syncOfflineSalesWithSupabase(storeId)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0c4a6e;strokeColor=#0ea5e9;fontColor=#ffffff;fontSize=11;" parent="box-suc-a" vertex="1">
                    <mxGeometry x="30" y="260" width="420" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="a-print" value="4. Impresión Térmica Directa 80mm&lt;br&gt;&lt;i&gt;WebUSB API (ESC/POS) + Apertura Cajón RJ11&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#831843;strokeColor=#db2777;fontColor=#ffffff;fontSize=11;" parent="box-suc-a" vertex="1">
                    <mxGeometry x="30" y="355" width="420" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="box-cloud-hub" value="SUPABASE REALTIME CLOUD HUB" style="swimlane;whiteSpace=wrap;html=1;fillColor=rgba(14, 165, 233, 0.08);strokeColor=#0ea5e9;fontColor=#38bdf8;fontStyle=1;fontSize=13;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="640" y="100" width="480" height="450" as="geometry"/>
                </mxCell>
                <mxCell id="hub-db" value="PostgreSQL DB — public.sales &amp; sales_items&lt;br&gt;&lt;i&gt;Inserta venta y descuenta stock automáticamente&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#065f46;strokeColor=#10b981;fontColor=#ffffff;fontStyle=1;fontSize=11;" parent="box-cloud-hub" vertex="1">
                    <mxGeometry x="30" y="50" width="420" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="hub-ch1" value="Canal Realtime WS: sales-live&lt;br&gt;&lt;i&gt;RealtimeMultiStoreService.subscribeSalesLive()&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0c4a6e;strokeColor=#0ea5e9;fontColor=#ffffff;fontSize=11;" parent="box-cloud-hub" vertex="1">
                    <mxGeometry x="30" y="150" width="420" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="hub-ch2" value="Canal Realtime WS: stock-live&lt;br&gt;&lt;i&gt;Notifica cambios de inventario a todas las cajas&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0c4a6e;strokeColor=#0ea5e9;fontColor=#ffffff;fontSize=11;" parent="box-cloud-hub" vertex="1">
                    <mxGeometry x="30" y="240" width="420" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="box-suc-b" value="SUCURSAL B / DASHBOARD EJECUTIVO EN VIVO" style="swimlane;whiteSpace=wrap;html=1;fillColor=rgba(168, 85, 247, 0.08);strokeColor=#a855f7;fontColor=#c084fc;fontStyle=1;fontSize=13;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="1220" y="100" width="500" height="450" as="geometry"/>
                </mxCell>
                <mxCell id="b-dash" value="Dashboard Ejecutivo (ExecutiveDashboardModal)&lt;br&gt;&lt;i&gt;Actualiza KPIs de Venta Total en Tiempo Real&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#581c87;strokeColor=#a855f7;fontColor=#ffffff;fontStyle=1;fontSize=11;" parent="box-suc-b" vertex="1">
                    <mxGeometry x="30" y="50" width="440" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="b-cajas" value="Monitoreo de Cajas (CashRegisterMonitoringModal)&lt;br&gt;&lt;i&gt;Visualiza arqueos y estado activo de todas las cajas&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#581c87;strokeColor=#a855f7;fontColor=#ffffff;fontSize=11;" parent="box-suc-b" vertex="1">
